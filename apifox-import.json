    "/photos/list": {
      "get": {
        "tags": [
          "图寻题目"
        ],
        "summary": "图片列表",
        "parameters": [
          {
            "name": "activity_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "example": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 20,
              "example": 10
            }
          },
          {
            "name": "solved",
            "in": "query",
            "schema": {
              "type": "boolean",
              "example": false
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "created_at",
                "likes_count",
                "attempts_count"
              ],
              "example": "created_at"
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 50,
              "example": "图书馆"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "分页列表"
          }
        }
      }
    },
    "/photos": {
      "post": {
        "tags": [
          "图寻题目"
        ],
        "summary": "上传投稿",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "activity_id",
                  "title",
                  "image",
                  "longitude",
                  "latitude"
                ],
                "properties": {
                  "activity_id": {
                    "type": "integer"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "image": {
                    "type": "string",
                    "format": "binary"
                  },
                  "longitude": {
                    "type": "number",
                    "format": "double"
                  },
                  "latitude": {
                    "type": "number",
                    "format": "double"
                  }
                }
              },
              "example": {
                "activity_id": 1,
                "title": "猜猜这是哪",
                "description": "校园神秘角落",
                "longitude": 108.123456,
                "latitude": 34.123456
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "成功"
          }
        }
      }
    },
    "/photos/{id}": {
