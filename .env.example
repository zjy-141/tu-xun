APP_SECRET = templete               # session密钥
APP_LANGUAGE = zh                   # 翻译语言
APP_MYSQL_HOST = 127.0.0.1          # MySQL地址
APP_MYSQL_PORT = 3306               # MySQL端口号
APP_MYSQL_NAME = tuxun           # MySQL数据库名称
APP_MYSQL_USER = root               # MySQL用户名
APP_MYSQL_PASS = 123456             # MySQL密码
APP_ALLOW_ORIGINS = *               # 允许跨域的源
APP_ALLOW_HEADERS = Origin|Content-Length|Content-Type|Authorization # 允许跨域的请求头,中间使用`|`作为分隔符
APP_LOG_LEVEL = debug               # 日志等级
OnlineCallback = 127.0.0.1:8088      # 统一认证返回地址
OSS_ACCESS_KEY_ID = your_access_key_id          # 阿里云OSS Access Key ID
OSS_ACCESS_KEY_SECRET  = your_access_key_secret      # 阿里云OSS Access Key Secret
OSS_REGION = cn-hangzhou                      # 阿里云OSS所在的地域，例如cn-hangzhou
OSS_BUCKET_NAME = your_bucket_name              # 阿里云OSS存储空间名称
OSS_USE_LOCAL = true                            # 是否使用本地存储（true或false）
AUTO_APPROVAL = all                             # 是否自动审核（all或attemptAndComment或comment或no）