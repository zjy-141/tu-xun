    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8088/api",
      "description": "本地开发"
    }
  ],
  "security": [],
  "paths": {
    "/test/login": {
      "get": {
        "tags": [
          "测试"
        ],
        "summary": "测试登录",
        "parameters": [
          {
            "name": "netid",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "20230001"
            }
          },
          {
            "name": "username",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "测试用户"
            }
          },
          {
            "name": "password",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "totoro@tiaozhan"
            },
            "description": "密码 totoro@tiaozhan"
          }
        ],
        "responses": {
          "200": {
            "description": "登录成功"
          }
        }
      }
    },
    "/user/login": {
      "get": {
        "tags": [
          "用户认证"
        ],
        "summary": "登录（重定向到学校统一认证）",
        "responses": {
          "302": {
            "description": "重定向"
          }
        }
      }
    },
    "/user/logincallback": {
      "get": {
        "tags": [
          "用户认证"
        ],
        "summary": "登录回调",
        "parameters": [
          {
            "name": "guid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "abc123-def456-ghi789"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "返回用户信息"
          }
        }
      }
    },
    "/user/logout": {
      "delete": {
        "tags": [
          "用户认证"
        ],
        "summary": "登出",
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
    "/user/userinfo": {
      "get": {
        "tags": [
          "用户认证"
        ],
        "summary": "获取个人信息",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "用户信息"
          }
        }
